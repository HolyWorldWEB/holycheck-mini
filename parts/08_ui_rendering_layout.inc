static void AddRoundedRect(GraphicsPath& path, const RectF& rect, float radius) {
    float diameter = radius * 2.0f;
    diameter = std::min(diameter, std::min(rect.Width, rect.Height));
    if (diameter <= 0.5f) { path.AddRectangle(rect); return; }
    path.AddArc(rect.X, rect.Y, diameter, diameter, 180.0f, 90.0f);
    path.AddArc(rect.GetRight() - diameter, rect.Y, diameter, diameter, 270.0f, 90.0f);
    path.AddArc(rect.GetRight() - diameter, rect.GetBottom() - diameter, diameter, diameter, 0.0f, 90.0f);
    path.AddArc(rect.X, rect.GetBottom() - diameter, diameter, diameter, 90.0f, 90.0f);
    path.CloseFigure();
}

static void DrawPanel(Graphics& g, const RectF& rect) {
    GraphicsPath path;
    AddRoundedRect(path, rect, 8.0f);
    SolidBrush fill(Color(145, 31, 32, 36));
    Pen border(Color(190, 70, 72, 80), 1.0f);
    g.FillPath(&fill, &path);
    g.DrawPath(&border, &path);
}

static void DrawDownloadLog(Graphics& g, RECT rc) {
    const float x = 28.0f;
    const float w = 438.0f;
    const float h = 150.0f;
    float y = static_cast<float>(rc.bottom) - h - 72.0f;
    if (y < 410.0f) y = 410.0f;
    DrawPanel(g, RectF(x, y, w, h));

    FontFamily family(L"Segoe UI");
    Font titleFont(&family, 13.0f, FontStyleBold, UnitPixel);
    Font lineFont(&family, 11.0f, FontStyleRegular, UnitPixel);
    SolidBrush titleBrush(Color(255, 238, 239, 244));
    SolidBrush textBrush(Color(255, 191, 194, 202));
    g.DrawString(L"Лог загрузки", -1, &titleFont, RectF(x + 14, y + 10, w - 28, 20), nullptr, &titleBrush);

    std::vector<std::wstring> lines;
    {
        std::lock_guard<std::mutex> lock(g_logMutex);
        lines = g_logLines;
    }
    const size_t visible = std::min<size_t>(7, lines.size());
    const size_t start = lines.size() - visible;
    float lineY = y + 36.0f;
    for (size_t i = start; i < lines.size(); ++i) {
        g.DrawString(lines[i].c_str(), -1, &lineFont, RectF(x + 14, lineY, w - 28, 16), nullptr, &textBrush);
        lineY += 15.0f;
    }
}

static void DrawProgressBar(Graphics& g, RECT rc) {
    const float x = 28.0f;
    const float y = static_cast<float>(rc.bottom - 46);
    const float width = static_cast<float>(rc.right) - 56.0f;
    const float height = 16.0f;
    if (width < 80.0f) return;

    GraphicsPath bgPath;
    AddRoundedRect(bgPath, RectF(x, y, width, height), 6.0f);
    SolidBrush bgBrush(Color(255, 42, 42, 46));
    g.FillPath(&bgBrush, &bgPath);

    const int percent = std::max(0, std::min(100, g_progressPercent.load()));
    const float fillW = width * percent / 100.0f;
    if (fillW > 0.5f) {
        GraphicsPath fillPath;
        AddRoundedRect(fillPath, RectF(x, y, fillW, height), 6.0f);
        SolidBrush fillBrush(Color(255, 128, 128, 140));
        g.FillPath(&fillBrush, &fillPath);
    }

    FontFamily family(L"Segoe UI");
    Font font(&family, 11.0f, FontStyleBold, UnitPixel);
    SolidBrush textBrush(Color(255, 235, 235, 240));
    StringFormat fmt;
    fmt.SetAlignment(StringAlignmentCenter);
    fmt.SetLineAlignment(StringAlignmentCenter);
    std::wstring label = std::to_wstring(percent) + L"%";
    g.DrawString(label.c_str(), -1, &font, RectF(x, y - 1, width, height + 2), &fmt, &textBrush);
}

namespace TileUi {
    static void AddRoundedRect(GraphicsPath& path, const RectF& rect, float radius) {
        float diameter = radius * 2.0f;
        if (diameter > rect.Width) diameter = rect.Width;
        if (diameter > rect.Height) diameter = rect.Height;
        if (diameter <= 0.5f) { path.AddRectangle(rect); return; }
        path.AddArc(rect.X, rect.Y, diameter, diameter, 180.0f, 90.0f);
        path.AddArc(rect.GetRight() - diameter, rect.Y, diameter, diameter, 270.0f, 90.0f);
        path.AddArc(rect.GetRight() - diameter, rect.GetBottom() - diameter, diameter, diameter, 0.0f, 90.0f);
        path.AddArc(rect.X, rect.GetBottom() - diameter, diameter, diameter, 90.0f, 90.0f);
        path.CloseFigure();
    }

    static void DrawCard(HDC hdc, const RECT& r, float radius, COLORREF top, COLORREF bottom,
                         COLORREF border, bool highlight, BYTE fillAlpha, BYTE borderAlpha) {
        Graphics graphics(hdc);
        graphics.SetSmoothingMode(SmoothingModeAntiAlias);
        graphics.SetPixelOffsetMode(PixelOffsetModeHalf);
        RectF bounds(static_cast<REAL>(r.left) + 0.5f, static_cast<REAL>(r.top) + 0.5f,
                     static_cast<REAL>(r.right - r.left) - 1.0f, static_cast<REAL>(r.bottom - r.top) - 1.0f);
        if (bounds.Width <= 1.0f || bounds.Height <= 1.0f) return;
        GraphicsPath path;
        AddRoundedRect(path, bounds, radius);
        LinearGradientBrush fillBrush(PointF(bounds.X, bounds.Y), PointF(bounds.X, bounds.GetBottom()),
            Color(fillAlpha, GetRValue(top), GetGValue(top), GetBValue(top)),
            Color(fillAlpha, GetRValue(bottom), GetGValue(bottom), GetBValue(bottom)));
        graphics.FillPath(&fillBrush, &path);
        if (highlight) {
            RectF inner(bounds.X + 1, bounds.Y + 1, bounds.Width - 2, bounds.Height - 2);
            if (inner.Width > 2 && inner.Height > 2) {
                GraphicsPath innerPath;
                AddRoundedRect(innerPath, inner, radius > 1 ? radius - 1 : radius);
                LinearGradientBrush hb(PointF(inner.X, inner.Y), PointF(inner.X, inner.GetBottom()),
                    Color(24, 205, 175, 255), Color(0, 205, 175, 255));
                Pen hp(&hb, 1.0f);
                graphics.DrawPath(&hp, &innerPath);
            }
        }
        Pen borderPen(Color(borderAlpha, GetRValue(border), GetGValue(border), GetBValue(border)), 1.0f);
        graphics.DrawPath(&borderPen, &path);
    }
}

