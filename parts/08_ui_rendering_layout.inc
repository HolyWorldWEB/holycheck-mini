static HWND g_hoverButton = nullptr;

static void InitParticles(int width, int height) {
    g_particles.clear();
    g_staticStars.clear();
    g_comets.clear();
    g_lastCometSpawn = 0;

    const int safeW = std::max(width, 1);
    const int safeH = std::max(height, 1);
    const int safeParticleH = std::max(safeH - 70, 1);
    if (safeW < 100 || safeH < 100) return;

    srand(static_cast<unsigned int>(time(nullptr)));
    for (int i = 0; i < 84; ++i) {
        Particle p{};
        p.x = 2.0f + static_cast<float>(rand() % std::max(safeW - 4, 1));
        p.y = 2.0f + static_cast<float>(rand() % std::max(safeParticleH - 4, 1));
        p.vx = ((rand() % 200) - 100) / 420.0f;
        p.vy = ((rand() % 200) - 100) / 420.0f;
        if (p.vx > -0.06f && p.vx < 0.06f) p.vx = 0.07f;
        if (p.vy > -0.06f && p.vy < 0.06f) p.vy = -0.07f;
        p.size = 1.2f + static_cast<float>(rand() % 3);
        p.alpha = static_cast<BYTE>(26 + rand() % 38);
        g_particles.push_back(p);
    }

    for (int i = 0; i < 150; ++i) {
        Star s{};
        s.x = 1.0f + static_cast<float>(rand() % std::max(safeW - 2, 1));
        s.y = 1.0f + static_cast<float>(rand() % std::max(safeParticleH - 2, 1));
        s.size = 0.6f + static_cast<float>(rand() % 20) / 10.0f;
        s.alpha = static_cast<BYTE>(20 + rand() % 70);
        s.phase = static_cast<float>(rand() % 628) / 100.0f;
        s.speed = 0.5f + static_cast<float>(rand() % 200) / 100.0f;
        g_staticStars.push_back(s);
    }
}

static void UpdateParticles(HWND hwnd) {
    if (g_particlesPaused || IsIconic(hwnd) || !IsWindowVisible(hwnd)) return;

    RECT rc{};
    GetClientRect(hwnd, &rc);
    const int width = static_cast<int>(rc.right - rc.left);
    const int height = static_cast<int>(rc.bottom - rc.top);
    if (width < 100 || height < 100) return;
    if (g_particles.empty()) InitParticles(width, height);

    static ULONGLONG lastTick = 0;
    const ULONGLONG now = GetTickCount64();
    float dt = lastTick ? static_cast<float>(now - lastTick) / 1000.0f : 0.05f;
    lastTick = now;
    if (dt > 0.2f) dt = 0.2f;
    const float moveScale = dt / 0.05f;

    const float minX = 2.0f, minY = 2.0f;
    const float maxX = static_cast<float>(std::max(width - 6, 4));
    const float maxY = static_cast<float>(std::max(height - 70, 4));

    for (auto& p : g_particles) {
        p.x += p.vx * moveScale;
        p.y += p.vy * moveScale;
        if (p.x < minX) p.x = maxX;
        if (p.x > maxX) p.x = minX;
        if (p.y < minY) p.y = maxY;
        if (p.y > maxY) p.y = minY;
    }

    if (g_lastCometSpawn == 0) g_lastCometSpawn = now;
    if (now - g_lastCometSpawn > 3000ULL + static_cast<ULONGLONG>(rand() % 5000) && g_comets.size() < 2) {
        g_lastCometSpawn = now;
        Comet c{};
        const bool leftToRight = (rand() % 2) == 0;
        const float speed = 220.0f + static_cast<float>(rand() % 140);
        c.x = leftToRight ? -12.0f : static_cast<float>(width + 12);
        c.y = 8.0f + static_cast<float>(rand() % std::max(height / 3, 40));
        c.vx = (leftToRight ? 1.0f : -1.0f) * speed;
        c.vy = speed * 0.45f;
        c.life = c.maxLife = 2.6f;
        g_comets.push_back(c);
    }

    for (size_t i = 0; i < g_comets.size();) {
        Comet& c = g_comets[i];
        c.x += c.vx * dt;
        c.y += c.vy * dt;
        c.life -= dt;
        if (c.life <= 0.0f || c.y > height + 40.0f || c.x < -80.0f || c.x > width + 80.0f)
            g_comets.erase(g_comets.begin() + i);
        else
            ++i;
    }

    RedrawWindow(hwnd, nullptr, nullptr, RDW_INVALIDATE | RDW_NOERASE | RDW_NOCHILDREN);
}

static void DrawParticles(Graphics& g, const RECT& rc) {
    const int width = static_cast<int>(rc.right - rc.left);
    const int height = static_cast<int>(rc.bottom - rc.top);
    if (g_particlesPaused || width < 100 || height < 100) return;

    const int clipHeight = std::max(height - 58, 1);
    GraphicsState state = g.Save();
    g.SetClip(Rect(0, 0, width, clipHeight), CombineModeReplace);
    g.SetSmoothingMode(SmoothingModeAntiAlias);

    SolidBrush starBrush(Color(255, 120, 160, 255));
    Pen linePen(Color(16, 150, 125, 200), 1.0f);
    const float timeSec = static_cast<float>(GetTickCount64() % 100000) / 1000.0f;

    for (const auto& s : g_staticStars) {
        float twinkle = 0.55f + 0.45f * sinf(timeSec * s.speed + s.phase);
        int a = static_cast<int>(s.alpha * twinkle);
        if (a < 4) a = 4;
        starBrush.SetColor(Color(static_cast<BYTE>(a), 180, 148, 255));
        g.FillEllipse(&starBrush, s.x, s.y, s.size, s.size);
    }

    for (size_t i = 0; i < g_particles.size(); ++i) {
        for (size_t j = i + 1; j < g_particles.size(); ++j) {
            const float dx = g_particles[i].x - g_particles[j].x;
            const float dy = g_particles[i].y - g_particles[j].y;
            if (dx * dx + dy * dy < 3600.0f)
                g.DrawLine(&linePen, g_particles[i].x, g_particles[i].y, g_particles[j].x, g_particles[j].y);
        }
    }

    for (const auto& p : g_particles) {
        starBrush.SetColor(Color(p.alpha, 150, 135, 255));
        g.FillEllipse(&starBrush, p.x, p.y, p.size, p.size);
    }

    for (const auto& c : g_comets) {
        const float lifeK = c.maxLife > 0.0f ? c.life / c.maxLife : 0.0f;
        const float vlen = sqrtf(c.vx * c.vx + c.vy * c.vy);
        if (vlen < 1.0f) continue;
        const float nx = -c.vx / vlen;
        const float ny = -c.vy / vlen;
        for (int seg = 0; seg < 4; ++seg) {
            const float d0 = 42.0f * seg / 4.0f;
            const float d1 = 42.0f * (seg + 1) / 4.0f;
            int a = static_cast<int>(150.0f * lifeK * (1.0f - seg / 4.0f));
            if (a < 5) continue;
            linePen.SetColor(Color(static_cast<BYTE>(a), 185, 150, 255));
            linePen.SetWidth(2.2f - seg * 0.45f);
            g.DrawLine(&linePen, c.x + nx * d0, c.y + ny * d0, c.x + nx * d1, c.y + ny * d1);
        }
        int headA = static_cast<int>(230.0f * lifeK);
        if (headA > 255) headA = 255;
        starBrush.SetColor(Color(static_cast<BYTE>(headA), 215, 190, 255));
        g.FillEllipse(&starBrush, c.x - 2.0f, c.y - 2.0f, 4.0f, 4.0f);
    }

    g.Restore(state);
}

